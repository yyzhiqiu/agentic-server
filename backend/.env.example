# 应用运行时配置
# APP_ENV 一般使用 local、dev、staging、production 等环境标识。
APP_NAME=Agent Platform
APP_ENV=local
DEBUG=true
# API_PREFIX 需要和前端的 VITE_API_PREFIX 保持一致。
API_PREFIX=/v1
# 缓存键和其他共享运行时数据使用的命名空间前缀。
CACHE_NAMESPACE=agent-platform

# 默认轻量身份配置
# 这些值用于游客访问或系统级兜底身份。
GUEST_USER_ID=guest
GUEST_USER_NAME=Guest
# 系统为 API Key 派生虚拟用户时使用的用户 ID 前缀。
API_KEY_USER_ID_PREFIX=api-key
# 对 API Key 身份做哈希时使用的随机盐。除本地开发外不要留空。
API_KEY_USER_HASH_SALT=

# 数据库
# 本地开发示例：PostgreSQL + asyncpg 驱动。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform
# 仅在排查问题需要详细 SQL 日志时再设为 true。
DATABASE_ECHO=false

# Redis 配置
# 只有在 Redis 已就绪且相关能力启用时才打开。
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 对象存储
# 使用 local 时，文件会写入 OBJECT_STORAGE_LOCAL_ROOT 指定的本地目录。
OBJECT_STORAGE_BACKEND=local
# 使用本地存储后端时，该路径相对于 backend/ 目录解析。
OBJECT_STORAGE_LOCAL_ROOT=data/object_storage

# LLM 提供方
# 提供方鉴权主要来自 LLM_API_KEY，也可配合可选的 LLM_BASE_URL 使用。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# 真实的模型提供方密钥。版本库示例中保持为空，在本地 .env 中填写。
LLM_API_KEY=
# 可选自定义地址，可用于 Azure、代理网关或自托管兼容层。
LLM_BASE_URL=
# 模型生成时使用的采样温度。
LLM_TEMPERATURE=0.2
# 上游 LLM 请求超时时间，单位为秒。
LLM_TIMEOUT=60
# 上游瞬时失败时的最大重试次数。
LLM_MAX_RETRIES=2

# Langfuse 可观测性
# 只有在当前环境已经配置好追踪或观测能力时才启用。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
# 服务端写入 Langfuse 时使用的密钥，真实值不要提交到版本库。
LANGFUSE_SECRET_KEY=
# 默认 Langfuse 云服务地址。自托管部署时请覆盖。
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS 配置
# 这里使用 JSON 数组字符串。联调或生产环境建议将 "*" 改为明确来源列表。
CORS_ORIGINS=["*"]
